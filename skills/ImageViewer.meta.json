{
  "name": "image_viewer",
  "version": "1.0.0",
  "description": "功能完整的图片查看器和管理器，替代 Windows 自带图片查看器",
  "tags": [],
  "dependencies": [
    "Pillow",
    "tkinter",
    "pyexiv2",
    "watchdog"
  ],
  "inputs": [
    {
      "name": "action",
      "type": "string",
      "description": "操作类型 (browse/view/info/edit/manage/slideshow/search/export/print)",
      "required": true
    },
    {
      "name": "source_dir",
      "type": "string",
      "description": "图片目录路径",
      "required": true
    },
    {
      "name": "file",
      "type": "string",
      "description": "单个图片文件路径",
      "required": true
    },
    {
      "name": "view_mode",
      "type": "string",
      "description": "查看模式 (grid/list/single)，默认 grid",
      "required": false
    },
    {
      "name": "sort_by",
      "type": "string",
      "description": "排序方式 (name/date/size/type)，默认 name",
      "required": false
    },
    {
      "name": "sort_order",
      "type": "string",
      "description": "排序顺序 (asc/desc)，默认 asc",
      "required": false
    },
    {
      "name": "filter",
      "type": "string",
      "description": "过滤条件 (all/images/videos/starred)，默认 all",
      "required": false
    },
    {
      "name": "thumbnail_size",
      "type": "integer",
      "description": "缩略图大小，默认 200",
      "required": false
    },
    {
      "name": "slideshow_interval",
      "type": "integer",
      "description": "幻灯片间隔(秒)，默认 3",
      "required": false
    },
    {
      "name": "fullscreen",
      "type": "boolean",
      "description": "是否全屏，默认 false",
      "required": false
    },
    {
      "name": "tags",
      "type": "string",
      "description": "标签列表，逗号分隔",
      "required": true
    },
    {
      "name": "star",
      "type": "integer",
      "description": "星标 0-5",
      "required": true
    },
    {
      "name": "rename_pattern",
      "type": "string",
      "description": "重命名模式",
      "required": true
    },
    {
      "name": "export_format",
      "type": "string",
      "description": "导出格式 (jpg/png/webp)",
      "required": true
    },
    {
      "name": "export_quality",
      "type": "integer",
      "description": "导出质量 1-100，默认 85",
      "required": false
    },
    {
      "name": "export_size",
      "type": "string",
      "description": "导出尺寸，如 800x600",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "files",
      "description": "文件列表"
    },
    {
      "name": "current_file",
      "description": "当前查看的文件"
    },
    {
      "name": "file_info",
      "description": "文件详细信息"
    },
    {
      "name": "thumbnails",
      "description": "缩略图列表"
    },
    {
      "name": "stats",
      "description": "统计信息"
    },
    {
      "name": "export_path",
      "description": "导出路径"
    },
    {
      "name": "message",
      "description": "操作结果消息"
    }
  ],
  "config": {}
}