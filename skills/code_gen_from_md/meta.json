{
    "name": "代码生成器（从 Markdown）",
    "description": "从 Markdown 需求文档自动生成高质量代码，包含语法检查、代码优化、单元测试和质量审查",
    "version": "1.0.0",
    "inputs": [
        {
            "name": "md_file",
            "type": "string",
            "required": false,
            "description": "Markdown 需求文件路径"
        },
        {
            "name": "md_content",
            "type": "string",
            "required": false,
            "description": "Markdown 需求内容（直接传入）"
        },
        {
            "name": "language",
            "type": "string",
            "required": false,
            "description": "目标语言（从 Markdown 自动检测，也可手动指定）",
            "default": "python"
        },
        {
            "name": "model",
            "type": "string",
            "required": false,
            "description": "Ollama 模型",
            "default": "qwen2.5:7b"
        }
    ],
    "outputs": [
        {"name": "title", "description": "项目名称"},
        {"name": "language", "description": "目标语言"},
        {"name": "saved_files", "description": "生成的文件列表"},
        {"name": "quality_score", "description": "质量评分 (0-100)"},
        {"name": "validations_passed", "description": "是否通过校验"}
    ],
    "dependencies": ["requests", "black", "pylint", "ast"]
}