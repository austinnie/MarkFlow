{
  "name": "ImageToolbox",
  "version": "1.0.0",
  "description": "图片批量处理工具箱",
  "tags": [],
  "dependencies": [
    "Pillow",
    "opencv-python",
    "numpy"
  ],
  "inputs": [
    {
      "name": "source_dir",
      "type": "string",
      "description": "源图片目录路径 (必填)",
      "required": true
    },
    {
      "name": "output_dir",
      "type": "string",
      "description": "输出目录路径，默认 ./processed_images",
      "required": false
    },
    {
      "name": "operations",
      "type": "string",
      "description": "操作类型，多个操作用逗号分隔 (resize,compress,convert,watermark,crop,rotate,color,thumbnail,grid)",
      "required": true
    },
    {
      "name": "target_format",
      "type": "string",
      "description": "目标格式 (jpg/png/webp/bmp/tiff)，默认保持原格式",
      "required": false
    },
    {
      "name": "width",
      "type": "integer",
      "description": "目标宽度",
      "required": true
    },
    {
      "name": "height",
      "type": "integer",
      "description": "目标高度",
      "required": true
    },
    {
      "name": "quality",
      "type": "integer",
      "description": "压缩质量 1-100，默认 85",
      "required": false
    },
    {
      "name": "watermark_text",
      "type": "string",
      "description": "水印文字内容",
      "required": true
    },
    {
      "name": "watermark_position",
      "type": "string",
      "description": "水印位置 (center/top-left/top-right/bottom-left/bottom-right)，默认 bottom-right",
      "required": false
    },
    {
      "name": "watermark_opacity",
      "type": "float",
      "description": "水印透明度 0-1，默认 0.7",
      "required": false
    },
    {
      "name": "crop_x",
      "type": "integer",
      "description": "裁剪起始 X 坐标",
      "required": true
    },
    {
      "name": "crop_y",
      "type": "integer",
      "description": "裁剪起始 Y 坐标",
      "required": true
    },
    {
      "name": "crop_width",
      "type": "integer",
      "description": "裁剪宽度",
      "required": true
    },
    {
      "name": "crop_height",
      "type": "integer",
      "description": "裁剪高度",
      "required": true
    },
    {
      "name": "rotate_angle",
      "type": "integer",
      "description": "旋转角度 (90/180/270)",
      "required": true
    },
    {
      "name": "flip_direction",
      "type": "string",
      "description": "翻转方向 (horizontal/vertical)",
      "required": true
    },
    {
      "name": "brightness",
      "type": "float",
      "description": "亮度调整 (-1.0 到 1.0)",
      "required": true
    },
    {
      "name": "contrast",
      "type": "float",
      "description": "对比度调整 (-1.0 到 1.0)",
      "required": true
    },
    {
      "name": "saturation",
      "type": "float",
      "description": "饱和度调整 (-1.0 到 1.0)",
      "required": true
    },
    {
      "name": "thumbnail_size",
      "type": "integer",
      "description": "缩略图尺寸，默认 200",
      "required": false
    },
    {
      "name": "grid_cols",
      "type": "integer",
      "description": "图册列数，默认 3",
      "required": false
    },
    {
      "name": "recursive",
      "type": "boolean",
      "description": "是否递归处理子目录，默认 true",
      "required": false
    },
    {
      "name": "pattern",
      "type": "string",
      "description": "文件匹配模式，默认 *.jpg,*.jpeg,*.png,*.webp,*.bmp,*.tiff",
      "required": false
    },
    {
      "name": "dry_run",
      "type": "boolean",
      "description": "预览模式，只显示处理计划不实际处理，默认 false",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "processed_count",
      "description": "成功处理文件数"
    },
    {
      "name": "failed_count",
      "description": "失败文件数"
    },
    {
      "name": "output_dir",
      "description": "输出目录路径"
    },
    {
      "name": "size_reduction",
      "description": "文件大小变化百分比"
    },
    {
      "name": "processing_time",
      "description": "处理耗时"
    }
  ],
  "config": {}
}